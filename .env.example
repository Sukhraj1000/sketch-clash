# Backend only. Copy to .env.local; never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_TIMEOUT_SECONDS=60
# Configurable limits for island agents only; normal requests have no app timer.
# These are app limits, not Google quotas. Atlas preserves island usage on restart.
# Legacy GEMINI_* limit names remain supported if the corresponding ISLAND_AI_* is absent.
ISLAND_AI_CONCURRENCY=1
ISLAND_AI_REQUESTS_PER_MINUTE=4
ISLAND_AI_REQUESTS_PER_DAY=200
ISLAND_AI_MAX_PENDING=8
MONGODB_URI=
MONGODB_DATABASE=sketch_clash
SKETCH_WORLD_ID=shared-demo
# Default is MongoDB. npm run dev:demo explicitly opts into temporary memory.
SKETCH_REPOSITORY=mongodb
FRONTEND_ORIGIN=http://127.0.0.1:5173
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=24000000
INFERENCE_MAX_EDGE=1600
# Bounds simultaneous normal requests, independently of island work; no pacing delay.
RECOGNITION_CONCURRENCY=2
EVIDENCE_TIMEOUT_SECONDS=30
YOLO_MODEL=yolo11n.pt
YOLO_ENABLED=true
OCR_ENABLED=true
# Optional genuine retrieval. Requires Atlas Vector Search and setup:retrieval.
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
MONGODB_VECTOR_INDEX=character_types_vector

# Shared across both colonies and prior original-island AI usage, per UTC day.
COLONY_REQUESTS_PER_DAY=0
# 0 removes the local daily cap; provider project quotas still apply.
COLONY_SESSION_INTERVAL_SECONDS=120
COLONY_PROPOSAL_MODEL=gemini-4-argon
COLONY_REPLY_MODEL=gemini-3.8-flash
