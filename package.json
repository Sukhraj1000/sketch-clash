{
  "name": "sketch-clash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:combat": "node scripts/verify-battle.mjs",
    "test:camera-combat": "node scripts/verify-camera-combat.mjs",
    "test:island-scene": "node scripts/verify-island-scene.mjs",
    "test:assembly-scene": "node scripts/verify-assembly-scene.mjs",
    "test:preview": "node scripts/verify-preview-framing.mjs",
    "test:factory-scene": "node scripts/verify-factory-scene.mjs",
    "test:robot-tasks": "node scripts/verify-robot-tasks.mjs",
    "test:project-benefits": "node scripts/verify-project-benefits.mjs",
    "test:agent-behavior": "node scripts/verify-agent-behavior.mjs",
    "test:playground": "node scripts/verify-playground.mjs",
    "test:receipts": "node scripts/verify-receipt-presentation.mjs",
    "setup:gemini": "node scripts/setup-gemini.mjs",
    "setup:mongodb": "node scripts/setup-mongodb.mjs",
    "operator:token": "node scripts/operator-token.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 5",
    "enable:recognition-fast": ".venv/bin/python backend/scripts/enable_interactive_recognition.py",
    "setup:vision": ".venv/bin/python backend/scripts/setup_vision.py",
    "test:backend": ".venv/bin/python -m pytest backend/tests -q",
    "setup:retrieval": ".venv/bin/python backend/scripts/setup_retrieval.py",
    "test:images": "node scripts/verify-image-input.mjs",
    "verify:retrieval": ".venv/bin/python backend/scripts/verify_retrieval.py",
    "dev:offline": "node scripts/dev.mjs --offline",
    "test:combat-v2": ".venv/bin/python -m pytest backend/tests/test_combat_v2.py backend/tests/test_arena_api.py -q",
    "check:combat-balance": ".venv/bin/python backend/scripts/check_combat_balance.py",
    "test:polish": "node scripts/verify-board-presentation.mjs && node scripts/verify-capture-recovery.mjs && node scripts/verify-review-loading.mjs && node scripts/verify-independent-polling.mjs && node scripts/verify-colony-activity.mjs && node scripts/verify-colony-conversation.mjs && node scripts/verify-observatory-feed.mjs && node scripts/verify-capture-progress.mjs && node scripts/verify-observatory-pacing.mjs",
    "setup:ebay": "node scripts/setup-ebay.mjs",
    "test:round-themes": "node scripts/verify-round-themes.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:demo": "docker compose -f compose.yaml -f compose.demo.yaml up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "rolldown": "~1.2.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
