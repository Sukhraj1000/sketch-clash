# Rendered by the nginx image's envsubst step; only ${API_UPSTREAM} is substituted.
server {
    listen 80;
    root /usr/share/nginx/html;
    # Backend accepts 5 MiB images plus multipart overhead.
    client_max_body_size 6m;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # The backend's origin check compares Origin with its own base URL, so keep the browser's Host.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Observatory uses server-sent events; recognition can take a minute.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
